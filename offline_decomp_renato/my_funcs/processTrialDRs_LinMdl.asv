function [muDRs, ensembleDRs, nMUsInCohort, meanDR, activePeriods, recruitThresh, covDRs, recruitThresh2, covDRs2, b_mus, rmse_mus, b_ens, rmse_ens, b_eval, rmse_eval]  ...
     = processTrialDRs_LinMdl(spiketrain, meanDR, force, cohortRanges, fs, fs_force, firingThreshHz, restThresh, minActiveDuration)
%{
    Helper function to process a single trial discharge rates and perform
    % linear regression between DRs of MUs and/or MU ensembles to force
    % Parameters:
    % spiketrain - Spiketrain data for the trial (nMUs x 1)
    % meanDR - mean DR of each MU (samples x nMUs)
    % force - Force data vector for the trial
    % fs - Sampling frequency of spiketrains
    % fs_force - Sampling frequency of force data
    % cohortRanges - Array (1 x numCohorts+1) specifying cohort threshold edges
    % firingThreshHz, restThresh, minActiveDuration: parameters to find MU spike trains active periods

    % Returns:
    %   smoothedRates: Cell array (1 x nMUs), each containing a matrix [time, smoothedRate].
%}                                  

    % Get whole trial and ramp durations in seconds
    trialDur = length(force)/fs_force;
    if trialDur == 74
        rampDur = 2;
    else
        rampDur = 4;
    end

    % Remove MUs with less than 100 spikes
    fewSpikes = sum(full(spiketrain(:,:)),1) < 100;
    spiketrain(:,fewSpikes) = [];
    meanDR(fewSpikes) = [];
    
    % Get active periods for both grids
    activePeriods = find_MU_active_periods_v2(spiketrain, firingThreshHz, fs, restThresh, minActiveDuration, 0);

    % Recruitment times
    recruitTimes = cell2mat(cellfun(@(x) min(x, [], "all"), activePeriods, 'UniformOutput',false));
    
    % Remove MUs recruited outside ramp
    outSpikes = (recruitTimes < 3) | (recruitTimes > (5+rampDur+2));
    spiketrain(:,outSpikes) = [];
    activePeriods(outSpikes) = [];
    recruitTimes(outSpikes) = [];
    meanDR(outSpikes) = [];
    % Recruitment thresholds
    recruitThresh = force(floor(recruitTimes .* fs_force));

    % We only keep the MUs with active periods over 55 seconds
    activeDurations = cellfun(@(x) max(x,[],"all") - min(x,[],"all"), activePeriods);
    activeMUs = find(activeDurations>55);
    spiketrain = spiketrain(:,activeMUs);
    meanDR = meanDR(activeMUs);
    activePeriods = activePeriods(activeMUs);
    recruitThresh = recruitThresh(activeMUs);
    recruitThresh2 = recruitThresh; % copy to be updated later

    % Smooth discharge rates with support vector regression
    smoothedDRs = smoothDischargeRates_SVR(spiketrain, activePeriods, fs, 0);

    covDRs = [];
    % Compute CoV of DRs
    for muIdx = 1:length(smoothedDRs)
        % Extract the smoothed DR (second column of the matrix)
        smoothedDR = smoothedDRs{muIdx}(:, 2);
        % Compute the CV for this MU
        muMean = mean(smoothedDR);
        muStd = std(smoothedDR);
        muCV = muStd / muMean;

        % Append to cohort CVs
        covDRs = [covDRs; muCV];
    end

    covDRs2 = covDRs; % to be updated later

    %% Compute ensembles linear analysis

    % Assign MUs to cohorts based on recruitment thresholds
    nCohorts = length(cohortRanges) - 1;
    cohortMUs = cell(1, nCohorts);
    emptyCoh = 0;
    for c = 1:nCohorts
        cohortMUs{c} = find(recruitThresh > cohortRanges(c) & recruitThresh <= cohortRanges(c+1));
        if isempty(cohortMUs{c})
            emptyCoh = emptyCoh+1;
        end
    end

    % Only continue if there are at least two cohorts
    if emptyCoh<=2
        % Create cumulative spike trains for each cohort (binary logic)
        ensembleSpikeTrains = zeros(size(spiketrain, 1), nCohorts);
        for c = 1:nCohorts
            if ~isempty(cohortMUs{c})
                cohortSpikes = spiketrain(:, cohortMUs{c});
                ensembleSpikeTrains(:, c) = any(cohortSpikes, 2); % Binary cumulative spike train
            end
        end
    
        % Find active periods and smooth discharge rates
        activePeriodsEnsembles = find_MU_active_periods_v2(ensembleSpikeTrains, firingThreshHz, fs, restThresh, minActiveDuration, 0);
        [ensembleDRs_stand, standTime, ~] = smoothDRs_SVR_standardised(ensembleSpikeTrains, activePeriodsEnsembles, force, fs, fs_force, fs);
        ensembleDRs_stand = ensembleDRs_stand'; % features in columns
    
        % Resample the force signal to match the standard time vector (sampled at fs)
        timeForce = (0:length(force) - 1) / fs_force; % Original time vector for force
        force_resamp = interp1(timeForce, force, standTime, 'linear', 0)';
    
        % Extract only the ramp-up phase (up to the end of ramp plus 3 secs)
        % Get ramp start from first recruited MU time
        firstRecTime = min(cell2mat(cellfun(@(x) min(x,[],'all'), activePeriodsEnsembles, 'UniformOutput', false)));
        rampUpIdx = (standTime >= firstRecTime) & (standTime <= (5+rampDur+3));
        ensembleDRs_ramp = ensembleDRs_stand(rampUpIdx, :);
        force_ramp = force_resamp(rampUpIdx);
    
        % Identify cohorts with actual MUs (non-zero smoothed DRs)
        hasMUs = any(ensembleDRs_ramp, 1);  % Logical array, 1 if cohort has at least one non-zero value
    
        % Filter predictors to include only cohorts with MUs
        ensembleDRs = ensembleDRs_ramp(:, hasMUs);
        validCohortIdx = find(hasMUs);  % Indices of cohorts with MUs
        nMUsInCohort = cellfun(@length, cohortMUs(validCohortIdx));
        % Normalise each cohort by the number of MUs
        ensembleDRs = ensembleDRs./nMUsInCohort;

        % Fit linear model using non-negative least squares regression (MUs contribution cannot be negative)
        b_ens = lsqnonneg(ensembleDRs, force_ramp);
    
        % figure;plot(ensembleDRs)
        % hold on
        % plot(force_ramp)
        % plot(fpred_ens)

        % Predict the curve using the regression coefficients
        fpred_ens = ensembleDRs * b_ens;  % X is your design matrix, b are the regression coefficients
        
        % Get RMSE
        rmse_ens = sqrt(mean((force_ramp - fpred_ens).^2)); 

        % As a complementary analysis, get weights at different time lengths including the force plateau
        plateuTimes = 0:5:50;
        b_eval = nan(length(b_ens),length(plateuTimes));
        rmse_eval = zeros(length(plateuTimes),1);
        for i =1:length(plateuTimes)
            tempIdx = (standTime >= firstRecTime) & (standTime <= (5+rampDur+plateuTimes(i)));
            tempDRs = ensembleDRs_stand(tempIdx, hasMUs);
            tempDRs = tempDRs./nMUsInCohort;
            tempF = force_resamp(tempIdx);
            b_eval(:,i) = lsqnonneg(tempDRs, tempF);
            rmse_eval(i,1) = sqrt(mean((tempF - tempDRs*b_eval(:,i)).^2));
        end
    
        % Create final arrays with consistent sizes in case there were empty cohorts
        if any(not(hasMUs)) 
            temp_b = b_ens;
            temp_b_eval = b_eval;
            temp_DR = ensembleDRs;
            temp_nMUs = nMUsInCohort;
            b_ens = nan(nCohorts,1);
            b_eval = nan(nCohorts, size(b_eval,2));
            ensembleDRs = nan(size(ensembleDRs,1), nCohorts);
            nMUsInCohort = zeros(1, nCohorts);
            b_ens(find(hasMUs)) = temp_b;
            b_eval(find(hasMUs),:) = temp_b_eval;
            ensembleDRs(:,find(hasMUs)) = temp_DR;
            nMUsInCohort(:,find(hasMUs)) = temp_nMUs;
        end

    else % everything is nan
            b_ens = nan;
            b_eval = nan;
            ensembleDRs = nan;
            nMUsInCohort = nan;
            fpred_ens = nan;
            rmse_ens = nan;
            rmse_eval = nan;
    end

    %% Compute individual linear MU analysis
    
    % Only continue if there are at least 2 MUs to analyse

    if size(spiketrain,2)>=2
        [muDRs_stand, standTime, recruitThresh] = smoothDRs_SVR_standardised(spiketrain, activePeriods, force, fs, fs_force, fs);
        muDRs_stand = muDRs_stand'; % features in columns
        % Resample the force signal to match the standard time vector
        % (sampled at fs)
        timeForce = (0:length(force) - 1) / fs_force; % Original time vector for force
        force_resamp = interp1(timeForce, force, standTime, 'linear', 0)'; % Pad missing values with zeros, samples as first dimension
    
        % Extract only the ramp-up phase (up to the end of ramp plus 3 secs)
        firstRecTime = min(cell2mat(cellfun(@(x) min(x,[],"all"), activePeriods, 'UniformOutput', false)));
        rampUpIdx = (standTime >= firstRecTime) & (standTime <= (5+rampDur+3));
        muDRs = muDRs_stand(rampUpIdx, :);
        force_ramp = force_resamp(rampUpIdx);
    
        % Fit linear model using non-negative least squares regression (MUs contribution cannot be negative)
        % and iteratively remove low-importance MUs
        weightsChanged = true;
        weightThreshold = 0.05; % Minimum importance/weight threshold for determining irrelevant MUs
        while weightsChanged
            % Fit linear model
            b_mus = lsqnonneg(muDRs, force_ramp);
            
            % Identify MUs with weights below the threshold
            lowImportanceMUs = find(b_mus < weightThreshold);
    
            % Check if there are changes to be made
            if isempty(lowImportanceMUs)
                weightsChanged = false; % Stop if all weights are above the threshold
            else
                % Remove low-importance MUs
                muDRs(:,lowImportanceMUs) = [];
                recruitThresh2(lowImportanceMUs) = [];
                covDRs2(lowImportanceMUs) = [];
            end
        end 
        
        % Predict the curve using the regression coefficients
        fpred_mus = muDRs * b_mus;  % X is your design matrix, b are the regression coefficients
        
        % Get RMSE
        rmse_mus = sqrt(mean((force_ramp - fpred_mus).^2));

    else
        muDRs = nan;
        b_mus = nan;
        rmse_mus = nan;
    end
    
end