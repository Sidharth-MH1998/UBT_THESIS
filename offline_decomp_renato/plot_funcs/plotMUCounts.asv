function plotMUCounts(MUsGrids, digLabels, forces, trials)
    % Function to plot MU counts for two grids across subjects, digits, and force levels
    %
    % Parameters:
    %   MUsGrids: A cell array (1 x 2) containing two 4D arrays (subjects x digits x forces x trials)
    %             for MU counts from two grids.
    %   digLabels: Cell array of strings for digit labels
    %   forces: Cell array of strings for force levels
    %   trials: Number of trials
    
    % Validate input
    if numel(MUsGrids) ~= 2
        error('This function is designed for two grids. Provide exactly two grids.');
    end
    
    % Get dimensions
    numSubjects = size(MUsGrids{1}, 1);
    numDigits = numel(digLabels);
    numForces = numel(forces);
    numConditions = numDigits * numForces;

    % Initialize storage for MU counts
    countArray = cell([numSubjects, numDigits, numForces]);

    % Process each grid
    for g = 1:2
        for S = 1:numSubjects
            for d = 1:numDigits
                for f = 1:numForces
                    for t = 1:trials
                        temp = MUsGrids{g}(S, d, f, t);
                        if ~isempty(temp)
                            countArray{S, d, f} = [countArray{S, d, f}, temp]; % Add values to cell
                        end
                    end
                end
            end
        end
    end

    % Compute means and standard deviations for each condition
    barData = zeros(numSubjects, numConditions);
    errData = zeros(numSubjects, numConditions);
    conditionLabels = cell(1, numConditions);
    colIdx = 1;
    for d = 1:numDigits
        for f = 1:numForces
            conditionLabels{colIdx} = sprintf('%s - %s', digLabels{d}, forces{f});
            for S = 1:numSubjects
                values = countArray{S, d, f};
                if ~isempty(values)
                    barData(S, colIdx) = mean(values); % Mean MU counts
                    errData(S, colIdx) = std(values);  % Standard deviation
                end
            end
            colIdx = colIdx + 1;
        end
    end

    % Compute overall mean and std per subject
    overallMeans = zeros(1, numSubjects);
    overallStds = zeros(1, numSubjects);
    totalMUCounts = zeros(1, numSubjects); % Total MU counts per subject
    for S = 1:numSubjects
        allValues = [];
        for d = 1:numDigits
            for f = 1:numForces
                allValues = [allValues, countArray{S, d, f}];
            end
        end
        if ~isempty(allValues)
            overallMeans(S) = mean(allValues);
            overallStds(S) = std(allValues);
            totalMUCounts(S) = sum(allValues);
        end
    end

    % Compute overall mean and std MU counts per trial across all subjects
    allTrialValues = [];
    for S = 1:numSubjects
        for d = 1:numDigits
            for f = 1:numForces
                allTrialValues = [allTrialValues, countArray{S, d, f}];
            end
        end
    end
    trialMean = mean(allTrialValues);
    trialStd = std(allTrialValues);

    % Print mean ± std MU counts per trial and total MU counts per subject
    fprintf('Mean ± std MU counts per trial across all subjects: %.2f ± %.2f\n', trialMean, trialStd);
    fprintf('Mean total MU counts per subject: %.2f \n', mean(totalMUCounts));

    % Plotting
    figure;

    % First subplot: Grouped bar chart per condition
    subplot(2, 1, 1);
    hold on;

    % Bar width and positions
    groupWidth = 0.8;
    barWidth = groupWidth / numConditions;
    x = 1:numSubjects;

    colors = lines(numConditions); % Colors for each condition
    barHandles = gobjects(1, numConditions);

    for c = 1:numConditions
        % Shift bar positions for grouping
        offset = (c - (numConditions + 1) / 2) * barWidth;
        xShifted = x + offset;

        % Plot bars and error bars
        barHandles(c) = bar(xShifted, barData(:, c), barWidth, 'FaceColor', colors(c, :), ...
            'EdgeColor', 'none', 'DisplayName', conditionLabels{c});
        errorbar(xShifted, barData(:, c), errData(:, c), 'k.', 'CapSize', 10, 'LineWidth', 1);
    end

    % Customize plot
    xlabel('Subjects');
    ylabel('Mean MU Counts');
    title('Grouped Bar Plot of MU Counts per Subject and Condition');
    legend(barHandles, 'Location', 'northeastoutside');
    xticks(1:numSubjects);
    xticklabels(arrayfun(@(s) sprintf('Subject %d', s), 1:numSubjects, 'UniformOutput', false));
    xlim([0.5, numSubjects + 0.5]);
    grid on;
    hold off;

    % Second subplot: Overall mean and std per subject
    subplot(2, 1, 2);
    hold on;

    % Plot bars and error bars
    bar(x, overallMeans, 0.6, 'FaceColor', [0.2, 0.6, 0.8], 'EdgeColor', 'none');
    errorbar(x, overallMeans, overallStds, 'k.', 'CapSize', 10, 'LineWidth', 1);

    % Customize plot
    xlabel('Subjects');
    ylabel('Overall Mean MU Counts');
    title('Overall Mean MU Counts per Subject');
    xticks(1:numSubjects);
    xticklabels(arrayfun(@(s) sprintf('Subject %d', s), 1:numSubjects, 'UniformOutput', false));
    xlim([0.5, numSubjects + 0.5]);
    grid on;
    hold off;

    sgtitle('MU Counts Analysis'); % Overall title for the figure
end